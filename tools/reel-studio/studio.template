<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Aadhyant Reel Studio</title>
<style>[hidden]{display:none!important}body{margin:0;background:#071923;color:#fff;font:16px system-ui}main{max-width:1060px;margin:40px auto;padding:24px}header small{color:#bad432;letter-spacing:3px}h1{font-size:38px;margin:12px 0}p{color:#bdcdd4;line-height:1.6}.grid{display:grid;grid-template-columns:1.4fr 1fr;gap:30px}form,aside{background:#112b37;border:1px solid #34505c;border-radius:20px;padding:24px}label{display:block;margin-top:17px;font-weight:600}input,textarea{display:block;box-sizing:border-box;width:100%;margin-top:8px;padding:13px;border-radius:9px;border:1px solid #536c76;background:#071923;color:#fff;font:inherit}textarea{min-height:240px;resize:vertical}button,a.download{background:#bad432;color:#071923;border:0;border-radius:10px;padding:14px 20px;font:700 16px system-ui;cursor:pointer;display:inline-block;margin-top:20px;text-decoration:none}button:disabled{opacity:.5;cursor:wait}video{width:100%;max-height:560px;border-radius:12px;background:#071923}#status{min-height:48px;color:#bad432}#error{color:#ffb6ab}.note{font-size:14px}@media(max-width:700px){main{margin:0;padding:18px}.grid{grid-template-columns:1fr}h1{font-size:30px}}</style>
<main><header><small>AADHYANT · MANPOWER & STAFFING</small><h1>Turn a post into a speaking Reel</h1><p>Paste your final Hindi announcement. Get a vertical MP4 with a Hindi voice, soft music and your WhatsApp contact.</p></header><div class="grid"><form id="form"><label>Video heading<input name="title" value="नौकरी का अवसर" maxlength="80" required></label><label>Post text / Hindi narration<textarea name="text" minlength="10" maxlength="1800" placeholder="कंपनी, पद, स्थान, वेतन, योग्यता, ड्यूटी और सुविधाएँ यहाँ लिखें।" required></textarea></label><p class="note">The voice reads this text as entered. Use Hindi text for Hindi speech. Include only confirmed details.</p><label>Poster (optional)<input id="poster" type="file" accept="image/png,image/jpeg"></label><label>Contact name<input name="name" value="Hitesh Gadhavi" maxlength="50" required></label><label>WhatsApp number<input name="phone" type="tel" value="9586785800" pattern="[6-9][0-9]{9}" required></label><button id="submit">Create Hindi Reel</button><p id="error" role="alert"></p></form><aside><h2>Your Reel</h2><p>1080 × 1920 · Hindi voice · MP4</p><p id="status" role="status" aria-live="polite">Add your post, then create a Reel.</p><video id="video" controls playsinline hidden></video><a id="download" class="download" hidden>Download MP4</a><p class="note">Review the video before sharing. Creating a video does not publish an ad or send WhatsApp messages.</p></aside></div></main>
<script>
const form=document.querySelector('#form'),button=document.querySelector('#submit'),status=document.querySelector('#status'),error=document.querySelector('#error'),video=document.querySelector('#video'),download=document.querySelector('#download');
function fileData(file){return new Promise((resolve,reject)=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result.split(',')[1]);reader.onerror=()=>reject(Error('Could not read this image.'));reader.readAsDataURL(file);});}
form.addEventListener('submit',async event=>{event.preventDefault();button.disabled=true;error.textContent='';video.hidden=true;download.hidden=true;status.textContent='Creating the Hindi voice and video. This can take a few minutes…';try{const data=Object.fromEntries(new FormData(form));const file=document.querySelector('#poster').files[0];if(file){if(!['image/png','image/jpeg'].includes(file.type)||file.size>6000000)throw Error('Choose a JPG or PNG smaller than 6 MB.');data.poster=await fileData(file);}const response=await fetch('/generate',{method:'POST',headers:{'Content-Type':'application/json','X-Reel-Token':'__TOKEN__'},body:JSON.stringify(data)});const job=await response.json();if(!response.ok)throw Error(job.error);await poll(job.id);}catch(e){error.textContent=e.message;status.textContent='Video not created.';}finally{button.disabled=false;}});
async function poll(id){const deadline=Date.now()+12*60*1000;while(Date.now()<deadline){await new Promise(r=>setTimeout(r,2000));const response=await fetch('/job/'+id);const job=await response.json();if(!response.ok||job.status==='failed')throw Error(job.error||'Video generation failed.');if(job.status==='ready'){video.src=job.url;video.hidden=false;download.href=job.url;download.download='Aadhyant-Hindi-Reel.mp4';download.hidden=false;status.textContent='Your Reel is ready. Play it and check the details before downloading.';return;}}throw Error('Generation is taking longer than expected. Leave this page open and check the output folder.');}
</script></html>
