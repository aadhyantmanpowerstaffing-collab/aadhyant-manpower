import test from 'node:test';import assert from 'node:assert/strict';
import {campaignMediaUrl} from '../supabase/functions/_shared/whatsapp/wanotifier-campaign-media.ts';
import {selectedVacancyPayload} from '../supabase/functions/wanotifier-campaign/index.ts';
const id='00000000-0000-4000-8000-000000000001',path=id+'/'+id+'.mp4',base='https://synthetic.supabase.co';
const vars={requirement_code:'AAD-2026-000023',company:'Factory',job_role:'Operator',job_location:'Sanand',qualification:'ITI',salary:'17000',take_home:'15000',overtime:'121 per hour',duty:'8 hours',benefits:'PF',template_contract:'registered_summary_v4',job_fingerprint:'a'.repeat(64),campaign_id:id};
const row={message_id:id,correlation_id:id,destination:'+919876543210',template_name:'aadhyant_registered_job_video_en_v1',template_language:'en',template_version:'1',purpose:'vacancy_campaign',consent_class:'marketing',template_variables:vars};
for(const language of ['en','hi'])test('video '+language+' uses the verified generated API schema',()=>{const r={...row,template_language:language,template_name:'aadhyant_registered_job_video_'+language+'_v1'};assert.throws(()=>selectedVacancyPayload(r));const p=selectedVacancyPayload(r,base+'/signed.mp4');assert.deepEqual(p.data,{header_video_url:base+'/signed.mp4',body_variables:Object.values(vars).slice(0,10),button_variables:[vars.requirement_code]});assert.deepEqual(p.recipients,[{whatsapp_number:row.destination}]);});
test('registration promotion contains only its canonical media field',()=>{const r={...row,template_name:'aadhyant_registration_video_hi_v1',template_language:'hi',template_variables:{template_contract:'registration_promotion_v1',campaign_id:id,recipient_id:id}};assert.deepEqual(selectedVacancyPayload(r,base+'/signed.mp4').data,{header_video_url:base+'/signed.mp4'});assert.throws(()=>selectedVacancyPayload({...r,template_variables:{...r.template_variables,phone:'untrusted'}},base+'/signed.mp4'));});
test('same-day route preserves seven variables and exact job suffix',()=>{const v={job_location:'Sanand',job_role:'Packing',work_date:'Tomorrow',shift:'8 hours',headcount:'5',pay:'500',payment:'Cash',requirement_code:'AAD-2026-000023',template_contract:'same_day_hi_v1',job_fingerprint:'b'.repeat(64)};const r={...row,template_name:'aadhyant_same_day_pay_hi_v2',template_language:'hi',template_variables:v};assert.deepEqual(selectedVacancyPayload(r).data,{body_variables:Object.values(v).slice(0,7),button_variables:[v.requirement_code]});assert.throws(()=>selectedVacancyPayload({...r,template_variables:{...v,job_fingerprint:''}}));});
for(const promotion of [false,true])test('private media is read only from the canonical lease-bound object '+promotion,async()=>{let calls=0;const r={...row,template_name:promotion?'aadhyant_registration_video_hi_v1':row.template_name};const bucket=promotion?'whatsapp-campaign-media':'recruitment-reels';const rpc=async(name:string,args:any)=>{assert.equal(name,'console_claimed_reel_object');assert.deepEqual(args,{p_message_id:id,p_worker_id:'worker'});return path;};const f=async(input:any,init:any)=>{calls++;const u=new URL(String(input));assert.equal(u.origin,base);assert.equal(init.redirect,'error');if(init.method==='HEAD'){assert.equal(u.pathname,'/storage/v1/object/authenticated/'+bucket+'/'+path);return new Response(null,{headers:{'content-type':'video/mp4','content-length':'1000'}});}assert.deepEqual(JSON.parse(init.body),{expiresIn:3600});return Response.json({signedURL:'/object/sign/'+bucket+'/'+path+'?token=synthetic'});};assert.equal(await campaignMediaUrl(r,'worker',base,'synthetic-service',rpc,f),base+'/storage/v1/object/sign/'+bucket+'/'+path+'?token=synthetic');assert.equal(calls,2);});
for(const p of ['../../private.mp4','https://attacker.invalid/video.mp4',id+'/../'+id+'.mp4'])test('media path cannot escape the private bucket '+p,async()=>{let calls=0;await assert.rejects(()=>campaignMediaUrl(row,'worker',base,'synthetic-service',async()=>p,async()=>{calls++;return new Response();}));assert.equal(calls,0);});
for(const options of [{type:'text/html',size:'1000'},{type:'video/mp4',size:'16000001'},{type:'video/mp4',size:''}])test('invalid media never obtains a provider URL '+JSON.stringify(options),async()=>{let calls=0;await assert.rejects(()=>campaignMediaUrl(row,'worker',base,'synthetic-service',async()=>path,async()=>{calls++;return new Response(null,{headers:{'content-type':options.type,'content-length':options.size}});}));assert.equal(calls,1);});
test('signed URL cannot point at another bucket or external host',async()=>{await assert.rejects(()=>campaignMediaUrl(row,'worker',base,'synthetic-service',async()=>path,async(_,init)=>init?.method==='HEAD'?new Response(null,{headers:{'content-type':'video/mp4','content-length':'1000'}}):Response.json({signedURL:'https://attacker.invalid/video.mp4'})));});
for(const format of ['PNG','JPEG'])test('job image uses a canonical private '+format+' object and exact image header',async()=>{const ext=format==='PNG'?'.png':'.jpg',p=id+'/'+id+ext,r={...row,template_name:'aadhyant_registered_job_image_hi_v1',template_language:'hi'};const url=await campaignMediaUrl(r,'worker',base,'synthetic-service',async(name,args)=>{assert.equal(name,'console_claimed_image_object');assert.equal(args.p_worker_id,'worker');return{path:p,format};},async(input,init)=>init?.method==='HEAD'?new Response(null,{headers:{'content-type':format==='PNG'?'image/png':'image/jpeg','content-length':'1000'}}):Response.json({signedURL:'/object/sign/whatsapp-campaign-media/'+p+'?token=synthetic'}));const payload=selectedVacancyPayload(r,url);assert.equal(payload.data.header_image_url,url);assert.equal(payload.data.header_video_url,undefined);assert.deepEqual(payload.data.body_variables,Object.values(vars).slice(0,10));});
