import test from 'node:test';import assert from 'node:assert/strict';
import {handleMedia} from '../supabase/functions/whatsapp-campaign-media/index.ts';
import {templatePayload,handleWorker} from '../supabase/functions/whatsapp-outbox-worker/index.ts';
const id='10000000-0000-0000-0000-000000000001',get=(k:string)=>({SUPABASE_URL:'https://db.invalid',SUPABASE_ANON_KEY:'anon',SUPABASE_SERVICE_ROLE_KEY:'service',WHATSAPP_ACCESS_TOKEN:'meta',WHATSAPP_BUSINESS_ACCOUNT_ID:'1234567890'}[k]||'');
const headers={origin:'https://aadhyantmanpower.in',authorization:'Bearer user','content-type':'video/mp4'};
const mp4=new Uint8Array(1000);mp4.set(new TextEncoder().encode('ftyp'),4);
const row={message_id:id,destination:'+919876543210',template_name:'aadhyant_registration_video_hi_v1',template_language:'hi',template_version:'1',purpose:'vacancy_campaign',consent_class:'marketing',correlation_id:id,template_variables:{template_contract:'registration_promotion_v1',campaign_id:id,recipient_id:id}};
test('registration payload has a VIDEO header, static URL template and STOP without fabricated job fields',()=>{const p=templatePayload(row,'https://private.invalid/video');assert.equal(p.template.components[0].parameters[0].type,'video');assert.equal(p.template.components.length,2);assert.equal(p.template.components[1].index,'1');assert.equal(p.template.components[1].parameters[0].payload,'STOP');assert.throws(()=>templatePayload(row));assert.throws(()=>templatePayload({...row,template_variables:{...row.template_variables,arbitrary:'bad'}},'https://private.invalid/v'));});
test('upload verifies admin before reading or storing; rejects invalid media',async()=>{const calls:string[]=[];const fake=(async(input:any)=>{calls.push(String(input));return Response.json(false);}) as typeof fetch;assert.equal((await handleMedia(new Request('https://edge.invalid',{method:'POST',headers,body:mp4}),get,fake)).status,403);assert.equal(calls.length,1);
const allow=(async()=>Response.json(true)) as typeof fetch;assert.equal((await handleMedia(new Request('https://edge.invalid',{method:'POST',headers,body:'bad'}),get,allow)).status,400);assert.equal((await handleMedia(new Request('https://edge.invalid',{method:'POST',headers:{...headers,'content-length':'16000001'},body:'bad'}),get,allow)).status,413);
});
test('upload writes a unique private object without upsert and registers only server generated metadata; no Graph call',async()=>{const calls:{url:string,init:any}[]=[];const fake=(async(input:any,init:any)=>{const url=String(input);calls.push({url,init});if(url.endsWith('admin_console_access'))return Response.json(true);if(url.endsWith('/auth/v1/user'))return Response.json({id});if(url.includes('/storage/v1/object/'))return Response.json({Key:'private'});if(url.endsWith('console_register_promotion_media'))return Response.json(id);throw Error('Unexpected request');}) as typeof fetch;
assert.equal((await handleMedia(new Request('https://edge.invalid',{method:'POST',headers,body:mp4}),get,fake)).status,200);const upload=calls.find(c=>c.url.includes('/storage/'));assert.equal(upload?.init.headers['x-upsert'],'false');assert.match(upload!.url,/whatsapp-campaign-media\/[a-f0-9-]{36}\/[a-f0-9-]{36}\.mp4$/);assert.ok(!calls.some(c=>c.url.includes('graph.facebook.com')));
});
test('registration worker signs the correct private bucket, rechecks final boundary and never calls Meta when rejected',async()=>{const calls:string[]=[];const fake=(async(input:any)=>{const url=String(input);calls.push(url);if(url.endsWith('admin_console_access'))return Response.json(true);if(url.endsWith('console_sender_configuration'))return Response.json({ready:true,phone_id:'1234567891',account_id:'1234567890'});if(url.endsWith('console_claim_campaign'))return Response.json([row]);if(url.endsWith('console_claimed_reel_object'))return Response.json(id+'/'+id+'.mp4');if(url.includes('/object/authenticated/whatsapp-campaign-media/'))return new Response(null,{headers:{'content-type':'video/mp4','content-length':'1000'}});if(url.includes('/object/sign/whatsapp-campaign-media/'))return Response.json({signedURL:'/object/sign/whatsapp-campaign-media/'+id+'/'+id+'.mp4?token=fixture'});if(url.endsWith('console_provider_boundary'))return new Response('{}',{status:400});if(url.endsWith('mark_whatsapp_outbound_failure'))return Response.json(true);throw Error('Unexpected request');}) as typeof fetch;
const r=await handleWorker(new Request('https://edge.invalid',{method:'POST',headers:{...headers,'content-type':'application/json'},body:JSON.stringify({campaign_id:id})}),{get},fake);assert.equal(r.status,200);assert.equal((await r.json()).failed,1);assert.ok(!calls.some(c=>c.includes('graph.facebook.com')));assert.ok(calls.some(c=>c.endsWith('console_provider_boundary')));
});
