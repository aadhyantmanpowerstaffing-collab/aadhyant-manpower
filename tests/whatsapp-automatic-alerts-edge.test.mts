import test from 'node:test';import assert from 'node:assert/strict';
import {handleWorker,templatePayload,summaryJobBody} from '../supabase/functions/whatsapp-outbox-worker/index.ts';
import {createRequire} from 'node:module';const require=createRequire(import.meta.url);const {run}=require('../scripts/whatsapp/run-registered-alerts.cjs');
const id='00000000-0000-0000-0000-000000000001',secret='a'.repeat(64);
const env:any={SUPABASE_URL:'https://fixture.invalid',SUPABASE_SERVICE_ROLE_KEY:'fixture-service',WHATSAPP_WORKER_SECRET:secret,WHATSAPP_AUTOMATIC_ALERTS_ENABLED:'true',WHATSAPP_BUSINESS_ACCOUNT_ID:'1234567890',WHATSAPP_PHONE_NUMBER_ID:'1234567891',WHATSAPP_ACCESS_TOKEN:'fixture-meta'};
const row={message_id:id,correlation_id:id,destination:'+919876543210',template_name:'aadhyant_registered_job_alert_v1',template_language:'en',template_version:'1',purpose:'vacancy_campaign',consent_class:'marketing',template_variables:{requirement_code:'AAD-TEST',job_role:'Associate',job_location:'Sanand',qualification:'10th, 12th, ITI',salary_details:'CTC INR 17000 monthly',benefits_details:'Free transport; 8 hour duty'}};
function network(options:any={}){const calls:string[]=[],bodies:any[]=[];return {calls,bodies,fetcher:(async(input:any,init:any)=>{const u=new URL(String(input)),name=u.pathname.split('/').at(-1)!;calls.push(name);bodies.push(JSON.parse(init?.body||'{}'));
 if(name==='admin_console_access')return Response.json(true);
 if(name==='phone_numbers')return Response.json({data:[{id:options.otherPhone?'1234567892':'1234567891'}]});
 if(name==='message_templates')return options.templateError?new Response('{}',{status:403}):Response.json({data:[],...(options.incomplete?{paging:{next:'https://evil.invalid'}}:{})});
 if(name==='console_sender_configuration')return Response.json({ready:true,phone_id:'1234567891',account_id:'1234567890'});
 if(name==='console_claim_registered_alerts')return Response.json([row]);
 if(name==='console_provider_boundary')return options.boundaryError?new Response('{}',{status:400}):Response.json(true);
 if(name==='messages')return Response.json({messages:[{id:'wamid.synthetic'}]});return Response.json(true);
 }) as typeof fetch};}
const req=(body:any={automatic:true},key=secret)=>new Request('https://fixture.invalid',{method:'POST',headers:{'x-whatsapp-worker-key':key},body:JSON.stringify(body)});
test('registered alert contains full job information, URL action and STOP; no Interested or registration action',()=>{const p=templatePayload(row),s=JSON.stringify(p);assert.equal(p.template.components[0].parameters.length,6);assert.equal(p.template.components[1].sub_type,'url');assert.equal(p.template.components[1].parameters[0].text,'AAD-TEST');assert.equal(s.includes('INTERESTED'),false);assert.equal(s.includes('STOP'),true);assert.throws(()=>templatePayload({...row,template_variables:{...row.template_variables,requirement_code:'x&evil=1'}}));assert.throws(()=>templatePayload({...row,template_variables:{...row.template_variables,benefits_details:'x'.repeat(501)}}));});
test('automatic worker verifies current Meta ownership and templates before a restricted automatic claim',async()=>{const net=network();const r=await handleWorker(req(),{get:k=>env[k]||''},net.fetcher);assert.equal(r.status,200);assert.equal((await r.json()).sent,1);assert.deepEqual(net.calls,['phone_numbers','message_templates','console_sync_templates','console_sender_connection','console_automatic_worker_heartbeat','console_sender_configuration','console_claim_registered_alerts','console_provider_boundary','messages','mark_whatsapp_outbound_sent']);assert.equal(net.calls.includes('console_claim_campaign'),false);});
test('automatic mode requires scheduler credentials, explicit gate and no selected campaign',async()=>{for(const request of [req({},'wrong'),req({automatic:true,campaign_id:id})]){const net=network();assert.ok((await handleWorker(request,{get:k=>env[k]||''},net.fetcher)).status>=400);assert.equal(net.calls.includes('messages'),false);}const net=network();assert.equal((await handleWorker(req(),{get:k=>k==='WHATSAPP_AUTOMATIC_ALERTS_ENABLED'?'':env[k]||''},net.fetcher)).status,503);assert.deepEqual(net.calls,[]);});
test('ownership mismatch, incomplete template lookup and provider boundary rejection send nothing',async()=>{for(const options of [{otherPhone:true},{templateError:true},{incomplete:true},{boundaryError:true}]){const net=network(options);await handleWorker(req(),{get:k=>env[k]||''},net.fetcher);assert.equal(net.calls.includes('messages'),false);if(!options.boundaryError)assert.equal(net.calls.includes('console_claim_registered_alerts'),false);}});
test('scheduler sends only automatic:true to the fixed endpoint and checks immutable source and result bounds',async()=>{const e={WHATSAPP_REGISTERED_ALERTS_ENABLED:'true',GITHUB_REPOSITORY:'aadhyantmanpowerstaffing-collab/aadhyant-manpower',GITHUB_REF:'refs/heads/main',GITHUB_EVENT_NAME:'schedule',WHATSAPP_REGISTERED_ALERTS_APPROVED_SHA:'b'.repeat(40),CHECKED_OUT_SHA:'b'.repeat(40),WHATSAPP_WORKER_SECRET:secret};let count=0;const fetcher=async(url:string,init:any)=>{count++;assert.equal(url,'https://wsuctjhbqiedttfnwjvf.supabase.co/functions/v1/whatsapp-outbox-worker');assert.equal(init.body,'{"automatic":true}');return Response.json({processed:1,sent:1,failed:0,reconciliation_required:0});};await run(e,fetcher);assert.equal(count,1);await assert.rejects(run({...e,CHECKED_OUT_SHA:'c'.repeat(40)},fetcher));await assert.rejects(run(e,async()=>Response.json({processed:11,sent:11,failed:0,reconciliation_required:0})));});

test('full v2 payload carries every section in order and retains a 2000-character description without an Interested action',()=>{const draft=JSON.parse(require('node:fs').readFileSync('docs/whatsapp/registered-job-alert-template-v2.json','utf8'));const map=JSON.parse(require('node:fs').readFileSync('docs/whatsapp/full-job-field-map.json','utf8'));const values:any=Object.fromEntries(map.parameter_keys.map((k:string,i:number)=>[k,draft.components[0].example.body_text[0][i]]));values.template_contract='registered_full_v2';values.description_1='a'.repeat(1000);values.description_2='b'.repeat(1000);const p=templatePayload({...row,template_name:draft.name,template_variables:values});assert.equal(p.template.components[0].parameters.length,15);assert.equal(p.template.components[0].parameters.at(-2).text.length,1000);assert.equal(p.template.components[0].parameters.at(-1).text.length,1000);assert.equal(JSON.stringify(p).includes('INTERESTED'),false);assert.throws(()=>templatePayload({...row,template_name:draft.name,template_variables:{...values,duty:'a\nb'}}));assert.throws(()=>templatePayload({...row,template_name:draft.name,template_variables:{...values,description_2:'x'.repeat(1001)}}));});

test('readable v3 provider payload retains fixed-line parameter order and fails closed on malformed or extra values',()=>{const fs=require('node:fs'),draft=JSON.parse(fs.readFileSync('docs/whatsapp/registered-job-alert-template-v3.json','utf8')),keys=JSON.parse(fs.readFileSync('docs/whatsapp/readable-job-parameter-keys.json','utf8'));const values:any=Object.fromEntries(keys.map((k:string,i:number)=>[k,draft.components[0].example.body_text[0][i]]));values.template_contract='registered_lines_v3';const input={...row,template_name:draft.name,template_variables:values};const p=templatePayload(input);assert.deepEqual(p.template.components[0].parameters.map((x:any)=>x.text),keys.map((k:string)=>values[k]));assert.equal(p.template.components[0].parameters.length,72);for(const override of [{line_2:'one\ntwo'},{line_2:'one     two'},{line_2:'x'.repeat(1001)},{bank_account:'secret'}])assert.throws(()=>templatePayload({...input,template_variables:{...values,...override}}));});

test('concise v4 sends ten ordered lines with full-job URL and STOP and rejects expanded body overflow',()=>{const fs=require('node:fs'),draft=JSON.parse(fs.readFileSync('docs/whatsapp/registered-job-alert-template-v4.json','utf8')),keys=JSON.parse(fs.readFileSync('docs/whatsapp/summary-job-parameter-keys.json','utf8'));assert.equal(summaryJobBody,draft.components[0].text);const values:any={...Object.fromEntries(keys.map((k:string,i:number)=>[k,draft.components[0].example.body_text[0][i]])),template_contract:'registered_summary_v4',job_fingerprint:'a'.repeat(64)};const input={...row,template_name:draft.name,template_variables:values};const p=templatePayload(input);assert.equal(p.template.components[0].parameters.length,10);assert.deepEqual(p.template.components[0].parameters.map((x:any)=>x.text),keys.map((k:string)=>values[k]));assert.equal(p.template.components[1].parameters[0].text,values.requirement_code);assert.equal(JSON.stringify(p).includes('job_fingerprint'),false);for(const overrides of [{job_fingerprint:'bad'},{salary:'one\ntwo'},{salary:'x'.repeat(300),benefits:'y'.repeat(300),qualification:'z'.repeat(300)},{bank_account:'secret'}])assert.throws(()=>templatePayload({...input,template_variables:{...values,...overrides}}));});

test('scheduler reports rejected HTTP status without exposing provider response or retrying',async()=>{const e={WHATSAPP_REGISTERED_ALERTS_ENABLED:'true',GITHUB_REPOSITORY:'aadhyantmanpowerstaffing-collab/aadhyant-manpower',GITHUB_REF:'refs/heads/main',GITHUB_EVENT_NAME:'schedule',WHATSAPP_REGISTERED_ALERTS_APPROVED_SHA:'b'.repeat(40),CHECKED_OUT_SHA:'b'.repeat(40),WHATSAPP_WORKER_SECRET:secret};let calls=0;await assert.rejects(run(e,async()=>{calls++;return new Response('private response must not appear',{status:401});}),{message:'Automatic worker did not confirm completion (HTTP 401); inspect Reports'});assert.equal(calls,1);});
test('database wake authenticates through service-only RPC and accepts only automatic mode',async()=>{
 const net=network(),calls:string[]=[];const fetcher=(async(u:any,i:any)=>{calls.push(String(u).split('/').at(-1)!);return net.fetcher(u,i);}) as typeof fetch;
 const wake=(body:any={automatic:true},key='b'.repeat(64))=>new Request('https://fixture.invalid',{method:'POST',headers:{'x-whatsapp-wake-key':key},body:JSON.stringify(body)});
 assert.equal((await handleWorker(wake(),{get:k=>env[k]||''},fetcher)).status,200);assert.equal(calls[0],'console_verify_automatic_wake');assert.equal(calls.includes('admin_console_access'),false);assert.equal(calls.filter(x=>x==='messages').length,1);
 for(const body of [{},{campaign_id:id},{automatic:true,campaign_id:id},{automatic:true,to:'919876543210'}]){const n=network();assert.ok((await handleWorker(wake(body),{get:k=>env[k]||''},n.fetcher)).status>=400);assert.equal(n.calls.includes('messages'),false);}
 const denied=network();const reject=(async(u:any,i:any)=>String(u).endsWith('/console_verify_automatic_wake')?Response.json(false):denied.fetcher(u,i)) as typeof fetch;assert.equal((await handleWorker(wake(),{get:k=>env[k]||''},reject)).status,401);assert.equal(denied.calls.length,0);
 assert.equal((await handleWorker(wake({},'bad'),{get:k=>env[k]||''},network().fetcher)).status,401);
});
