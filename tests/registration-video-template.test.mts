import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';
import {handleRegistrationTemplate,reviewedTemplate} from '../supabase/functions/whatsapp-registration-video-template/index.ts';
const id='10000000-0000-0000-0000-000000000001',path=id+'/'+id+'.mp4';
const get=(k:string)=>({SUPABASE_URL:'https://db.invalid',SUPABASE_ANON_KEY:'anon',SUPABASE_SERVICE_ROLE_KEY:'service',WHATSAPP_ACCESS_TOKEN:'meta-secret',WHATSAPP_BUSINESS_ACCOUNT_ID:'1234567890'}[k]||'');
const req=()=>new Request('https://edge.invalid',{method:'POST',headers:{origin:'https://aadhyantmanpower.in',authorization:'Bearer user'},body:JSON.stringify({media_id:id})});
function fake({existing=false,denied=false,ambiguous=false}={}){const calls:{url:string,init:any}[]=[];let created=0;return {calls,get created(){return created;},fetcher:(async(input:any,init:any)=>{const url=String(input);calls.push({url,init});if(url.endsWith('admin_console_access'))return Response.json(!denied);if(url.endsWith('console_sender_configuration'))return Response.json({account_id:'1234567890'});if(url.includes('/message_templates?'))return Response.json({data:existing?[{...reviewedTemplate,status:'APPROVED',id:'1234567895'}]:[]});if(url.endsWith('console_promotion_media_object'))return Response.json(path);if(url.includes('/object/authenticated/'))return new Response(new Uint8Array(1000),{headers:{'content-length':'1000','content-type':'video/mp4'}});if(url.includes('/app/uploads/'))return Response.json({id:'upload:fixture?sig=test'});if(url.includes('/upload:fixture'))return Response.json({h:'sample-handle'});if(url.endsWith('/message_templates')){created++;if(ambiguous)throw Error('timeout');return Response.json({id:'1234567895',status:'PENDING'});}throw Error('Unexpected '+url);}) as typeof fetch};}
test('reviewed spec matches the SQL and documented fixed registration template',()=>{assert.deepEqual(reviewedTemplate,JSON.parse(fs.readFileSync('docs/whatsapp/registration-video-template-hi-v1.json','utf8')));assert.ok(fs.readFileSync('supabase/migrations/20261028090000_registration_video_campaign.sql','utf8').includes(reviewedTemplate.components[1].text as string));});
test('Meta setup denies non-admin before media upload or template mutation',async()=>{const n=fake({denied:true});assert.equal((await handleRegistrationTemplate(req(),get,n.fetcher)).status,403);assert.equal(n.calls.length,1);});
test('exact existing approved template is reused without review media upload or create',async()=>{const n=fake({existing:true});const r=await handleRegistrationTemplate(req(),get,n.fetcher);assert.equal(r.status,200);assert.deepEqual(await r.json(),{status:'APPROVED',created:false});assert.equal(n.created,0);assert.ok(!n.calls.some(c=>c.url.includes('/storage/')));});
test('one resumable sample upload and reviewed template submission; no WhatsApp messages endpoint',async()=>{const n=fake();const r=await handleRegistrationTemplate(req(),get,n.fetcher);assert.equal(r.status,200);assert.equal((await r.json()).status,'PENDING');assert.equal(n.created,1);const post=n.calls.find(c=>c.url.endsWith('/message_templates'));const spec=JSON.parse(post!.init.body);assert.equal(spec.components[0].example.header_handle[0],'sample-handle');assert.equal(spec.components[2].buttons[0].url,'https://aadhyantmanpower.in/');assert.ok(!n.calls.some(c=>c.url.endsWith('/messages')));});
test('ambiguous create is never retried within one invocation and secrets are absent from errors',async()=>{const n=fake({ambiguous:true});const r=await handleRegistrationTemplate(req(),get,n.fetcher);assert.equal(r.status,502);assert.equal(n.created,1);assert.ok(!(await r.text()).includes('meta-secret'));});
