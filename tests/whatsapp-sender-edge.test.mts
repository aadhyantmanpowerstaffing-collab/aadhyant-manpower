import test from 'node:test';import assert from 'node:assert/strict';
import {handleWorker,templatePayload} from '../supabase/functions/whatsapp-outbox-worker/index.ts';
import {handleSetup} from '../supabase/functions/whatsapp-sender-setup/index.ts';
const campaign='00000000-0000-0000-0000-000000000001';
const row={message_id:campaign,correlation_id:campaign,destination:'+919876543210',template_name:'aadhyant_vacancy_alert_v1',template_language:'en',template_version:'1',purpose:'vacancy_campaign',consent_class:'marketing',template_variables:{requirement_code:'JOB-1',job_role:'Fitter'}};
const env={SUPABASE_URL:'https://fixture.invalid',SUPABASE_ANON_KEY:'anon',SUPABASE_SERVICE_ROLE_KEY:'service',WHATSAPP_ACCESS_TOKEN:'meta',WHATSAPP_BUSINESS_ACCOUNT_ID:'1234567890',WHATSAPP_APP_SECRET:'fixture',WHATSAPP_WEBHOOK_VERIFY_TOKEN:'fixture'};
const get=(k:string)=>env[k as keyof typeof env]||'';
const req=()=>new Request('https://fixture.invalid',{method:'POST',headers:{origin:'https://aadhyantmanpower.in',authorization:'Bearer user'},body:JSON.stringify({campaign_id:campaign})});
function network(overrides:Record<string,any>={}){const calls:string[]=[],payloads:any[]=[];const fetcher=async(input:any,init:any)=>{const url=String(input),name=url.split('/').pop()!;calls.push(name);payloads.push(JSON.parse(init?.body||'{}'));if(name==='admin_console_access')return Response.json(overrides.admin??true);if(name==='console_sender_configuration')return Response.json({ready:true,phone_id:'1234567891',account_id:'1234567890'});if(name==='console_claim_campaign')return Response.json([row]);if(name==='console_provider_boundary')return overrides.boundary===false?new Response('{}',{status:400}):Response.json(true);if(name==='messages'){if(overrides.ambiguous)throw Error('timeout');return Response.json(overrides.provider||{messages:[{id:'wamid.fixture'}]},{status:overrides.status||200});}return Response.json(true);};return {calls,payloads,fetcher:fetcher as typeof fetch};}
test('payload uses actual job variables and exact interested/stop quick replies',()=>{const p=templatePayload(row);assert.equal(p.template.components[0].parameters[0].text,'JOB-1');assert.equal(p.template.components[1].parameters[0].payload,'INTERESTED');assert.equal(p.template.components[2].parameters[0].payload,'STOP');assert.throws(()=>templatePayload({...row,template_language:'en_US'}));});
test('admin authorization precedes any claim; no user-controlled destination/template override',async()=>{const net=network({admin:false});assert.equal((await handleWorker(req(),{get},net.fetcher)).status,403);assert.deepEqual(net.calls,['admin_console_access']);const bad=new Request('https://fixture.invalid',{method:'POST',headers:{origin:'https://aadhyantmanpower.in',authorization:'Bearer user'},body:JSON.stringify({campaign_id:campaign,to:'919999999999'})});assert.equal((await handleWorker(bad,{get},network().fetcher)).status,400);});
test('claim -> final boundary -> one Meta attempt -> durable receipt',async()=>{const net=network();const r=await handleWorker(req(),{get},net.fetcher);assert.equal(r.status,200);assert.deepEqual(net.calls,['admin_console_access','console_sender_configuration','console_claim_campaign','console_provider_boundary','messages','mark_whatsapp_outbound_sent']);assert.equal((await r.json()).sent,1);});
test('final guard rejection never invokes Meta',async()=>{const net=network({boundary:false});await handleWorker(req(),{get},net.fetcher);assert.equal(net.calls.includes('messages'),false);assert.equal(net.calls.at(-1),'mark_whatsapp_outbound_failure');});
test('ambiguous provider result records reconciliation and never retries',async()=>{const net=network({ambiguous:true});const r=await handleWorker(req(),{get},net.fetcher);assert.equal((await r.json()).reconciliation_required,1);assert.equal(net.calls.filter(x=>x==='messages').length,1);assert.equal(net.payloads.at(-1).p_failure_kind,'ambiguous');});
test('provider rejection is terminal and status reports failed, without token/body leakage',async()=>{const net=network({status:400,provider:{error:{code:131049,message:'private error'}}});const r=await handleWorker(req(),{get},net.fetcher);assert.equal((await r.json()).failed,1);assert.equal(net.payloads.at(-1).p_error_code,'131049');assert.equal(JSON.stringify(net.payloads).includes('private error'),false);});
test('sender setup only reads Meta account phone list and saves verified ownership; it never sends',async()=>{const calls:string[]=[];const fetcher=async(input:any,init:any)=>{const u=String(input);calls.push(u);if(u.includes('admin_console_access'))return Response.json(true);if(u.includes('phone_numbers'))return Response.json({data:[{id:'1234567891',display_phone_number:'+91 9876543210'}]});assert.deepEqual(JSON.parse(init.body),{p_phone_id:'1234567891',p_account_id:'1234567890'});return Response.json(true);};const r=await handleSetup(req(),get,fetcher as typeof fetch);assert.equal(r.status,200);assert.equal(calls.some(x=>x.endsWith('/messages')),false);assert.equal((await r.json()).phone_masked,'••••••3210');});
test('multiple phone identities and missing webhook credentials cannot unlock sending',async()=>{const fetcher=async(input:any)=>String(input).includes('admin_console_access')?Response.json(true):Response.json({data:[{id:'1234567891'},{id:'1234567892'}]});assert.equal((await handleSetup(req(),get,fetcher as typeof fetch)).status,503);assert.equal((await handleSetup(req(),k=>k==='WHATSAPP_APP_SECRET'?'':get(k),fetcher as typeof fetch)).status,503);});
