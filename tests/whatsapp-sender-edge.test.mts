import test from 'node:test';import assert from 'node:assert/strict';
import {handleWorker,templatePayload} from '../supabase/functions/whatsapp-outbox-worker/index.ts';
import {handleSetup} from '../supabase/functions/whatsapp-sender-setup/index.ts';
const campaign='00000000-0000-0000-0000-000000000001';
const row={message_id:campaign,correlation_id:campaign,destination:'+919876543210',template_name:'aadhyant_vacancy_alert_v1',template_language:'en',template_version:'1',purpose:'vacancy_campaign',consent_class:'marketing',template_variables:{requirement_code:'JOB-1',job_role:'Fitter'}};
const env={SUPABASE_URL:'https://fixture.invalid',SUPABASE_ANON_KEY:'anon',SUPABASE_SERVICE_ROLE_KEY:'service',WHATSAPP_ACCESS_TOKEN:'meta',WHATSAPP_BUSINESS_ACCOUNT_ID:'1234567890',WHATSAPP_APP_SECRET:'fixture',WHATSAPP_WEBHOOK_VERIFY_TOKEN:'fixture'};
const get=(k:string)=>env[k as keyof typeof env]||'';
const req=()=>new Request('https://fixture.invalid',{method:'POST',headers:{origin:'https://aadhyantmanpower.in',authorization:'Bearer user'},body:JSON.stringify({campaign_id:campaign})});
function network(overrides:Record<string,any>={}){const calls:string[]=[],payloads:any[]=[];const fetcher=async(input:any,init:any)=>{const url=String(input),name=url.split('/').pop()!;calls.push(name);payloads.push(JSON.parse(init?.body||'{}'));if(name==='admin_console_access')return Response.json(overrides.admin??true);if(name==='console_sender_configuration')return Response.json({ready:true,phone_id:'1234567891',account_id:'1234567890'});if(name==='console_claim_campaign')return Response.json([row]);if(name==='console_provider_boundary')return overrides.boundary===false?new Response('{}',{status:400}):Response.json(true);if(name==='messages'){if(overrides.ambiguous)throw Error('timeout');return Response.json(overrides.provider||{messages:[{id:'wamid.fixture'}]},{status:overrides.status||200});}return Response.json(true);};return {calls,payloads,fetcher:fetcher as typeof fetch};}
test('payload uses actual job variables and exact interested/stop quick replies',()=>{const p=templatePayload(row);assert.equal(p.template.components[0].parameters[0].text,'JOB-1');assert.equal(p.template.components[1].parameters[0].payload,'INTERESTED');assert.equal(p.template.components[2].parameters[0].payload,'STOP');assert.throws(()=>templatePayload({...row,template_language:'en_US'}));});
test('admin authorization precedes any claim; no user-controlled destination/template override',async()=>{const net=network({admin:false});assert.equal((await handleWorker(req(),{get},net.fetcher)).status,403);assert.deepEqual(net.calls,['admin_console_access']);const bad=new Request('https://fixture.invalid',{method:'POST',headers:{origin:'https://aadhyantmanpower.in',authorization:'Bearer user'},body:JSON.stringify({campaign_id:campaign,to:'919999999999'})});assert.equal((await handleWorker(bad,{get},network().fetcher)).status,400);});
test('claim -> final boundary -> one Meta attempt -> durable receipt',async()=>{const net=network();const r=await handleWorker(req(),{get},net.fetcher);assert.equal(r.status,200);assert.deepEqual(net.calls,['admin_console_access','console_sender_configuration','console_claim_campaign','console_provider_boundary','messages','mark_whatsapp_outbound_sent']);assert.equal((await r.json()).sent,1);});
test('final guard rejection never invokes Meta',async()=>{const net=network({boundary:false});await handleWorker(req(),{get},net.fetcher);assert.equal(net.calls.includes('messages'),false);assert.equal(net.calls.at(-1),'mark_whatsapp_outbound_failure');});
test('ambiguous provider result records reconciliation and never retries',async()=>{const net=network({ambiguous:true});const r=await handleWorker(req(),{get},net.fetcher);assert.equal((await r.json()).reconciliation_required,1);assert.equal(net.calls.filter(x=>x==='messages').length,1);assert.equal(net.payloads.at(-1).p_failure_kind,'ambiguous');});
test('provider rejection is terminal and status reports failed, without token/body leakage',async()=>{const net=network({status:400,provider:{error:{code:131049,message:'private error'}}});const r=await handleWorker(req(),{get},net.fetcher);assert.equal((await r.json()).failed,1);assert.equal(net.payloads.at(-1).p_error_code,'131049');assert.equal(JSON.stringify(net.payloads).includes('private error'),false);});
test('sender setup only reads Meta account phone list and saves verified ownership; it never sends',async()=>{const calls:string[]=[];const fetcher=async(input:any,init:any)=>{const u=String(input);calls.push(u);if(u.includes('admin_console_access'))return Response.json(true);if(u.includes('phone_numbers'))return Response.json({data:[{id:'1234567891',display_phone_number:'+91 9876543210'}]});assert.deepEqual(JSON.parse(init.body),{p_phone_id:'1234567891',p_account_id:'1234567890'});return Response.json(true);};const r=await handleSetup(req(),get,fetcher as typeof fetch);assert.equal(r.status,200);assert.equal(calls.some(x=>x.endsWith('/messages')),false);assert.equal((await r.json()).phone_masked,'••••••3210');});
test('multiple phone identities and missing webhook credentials cannot unlock sending',async()=>{const fetcher=async(input:any)=>String(input).includes('admin_console_access')?Response.json(true):Response.json({data:[{id:'1234567891'},{id:'1234567892'}]});assert.equal((await handleSetup(req(),get,fetcher as typeof fetch)).status,503);assert.equal((await handleSetup(req(),k=>k==='WHATSAPP_APP_SECRET'?'':get(k),fetcher as typeof fetch)).status,503);});
test('Hindi Same-Day Pay binds seven ordered body values, private vacancy URL suffix and STOP; malformed contracts fail closed',()=>{
 const v={template_contract:'same_day_hi_v1',requirement_code:'AAD-2026-000005',job_location:'Sanand GIDC',job_role:'Helper',work_date:'20-10-2026',shift:'08:00 – 12:00 IST (4 घंटे)',headcount:'10',pay:'₹350',payment:'शिफ्ट पूरी होते ही, 12:00 IST, UPI',job_fingerprint:'a'.repeat(64)};
 const r={...row,template_name:'aadhyant_same_day_pay_hi_v1',template_language:'hi',template_variables:v};const p=templatePayload(r);assert.equal(p.template.language.code,'hi');assert.deepEqual(p.template.components[0].parameters.map(x=>x.text),[v.job_location,v.job_role,v.work_date,v.shift,v.headcount,v.pay,v.payment]);assert.equal(p.template.components[1].parameters[0].text,v.requirement_code);assert.equal(p.template.components[2].parameters[0].payload,'STOP');
 for(const change of [{template_language:'en'},{template_version:'2'},{template_variables:{...v,pay:''}},{template_variables:{...v,job_role:'x\nY'}},{template_variables:{...v,contact_phone:'9876543210'}},{template_variables:{...v,requirement_code:'https://evil.invalid'}}])assert.throws(()=>templatePayload({...r,...change}));
});
test('Hindi registered job campaign sends ten ordered fields, correct language, application URL and STOP',()=>{
 const keys=['requirement_code','company','job_role','job_location','qualification','salary','take_home','overtime','duty','benefits'];
 const v:any={template_contract:'registered_summary_v4',job_fingerprint:'a'.repeat(64)};for(const k of keys)v[k]=k==='requirement_code'?'AAD-2026-000023':'Value';
 const r={...row,template_name:'aadhyant_registered_job_alert_hi_v1',template_language:'hi',template_variables:v};const p=templatePayload(r);assert.equal(p.template.language.code,'hi');assert.deepEqual(p.template.components[0].parameters.map(x=>x.text),keys.map(k=>v[k]));assert.equal(p.template.components[1].parameters[0].text,v.requirement_code);assert.equal(p.template.components[2].parameters[0].payload,'STOP');
 for(const change of [{template_language:'en'},{template_version:'2'},{template_variables:{...v,company:''}},{template_variables:{...v,salary:'x\ny'}},{template_variables:{...v,bank_account:'private'}},{template_variables:{...v,job_fingerprint:'invalid'}}])assert.throws(()=>templatePayload({...r,...change}));
});
test('video alert carries the same job details, one video header, application link and STOP',()=>{
 const names=['requirement_code','company','job_role','job_location','qualification','salary','take_home','overtime','duty','benefits'];const v:any={template_contract:'registered_summary_v4',job_fingerprint:'a'.repeat(64)};for(const k of names)v[k]=k==='requirement_code'?'JOB-1':'Value';
 const r={...row,template_name:'aadhyant_registered_job_video_en_v1',template_variables:v};
 assert.throws(()=>templatePayload(r));assert.throws(()=>templatePayload(r,'http://unsafe.invalid'));
 const p=templatePayload(r,'https://fixture.invalid/private.mp4?token=fixture');assert.equal(p.template.name,r.template_name);assert.equal(p.template.components[0].type,'header');assert.deepEqual(p.template.components[0].parameters[0],{type:'video',video:{link:'https://fixture.invalid/private.mp4?token=fixture'}});
 assert.equal(p.template.components[1].parameters.length,10);assert.equal(p.template.components[2].parameters[0].text,'JOB-1');assert.equal(p.template.components[3].parameters[0].payload,'STOP');
});
test('video worker signs only a leased canonical Reel, validates media limits, and keeps final boundary before send',async()=>{
 const names=['requirement_code','company','job_role','job_location','qualification','salary','take_home','overtime','duty','benefits'];const v:any={template_contract:'registered_summary_v4',job_fingerprint:'a'.repeat(64)};for(const k of names)v[k]=k==='requirement_code'?'JOB-1':'Value';const videoRow={...row,template_name:'aadhyant_registered_job_video_en_v1',template_variables:v};const path=campaign+'/'+campaign+'.mp4';
 for(const size of [1200,17000000]){
  const net=network();const calls:string[]=[];
  const fetcher=async(input:any,init:any)=>{const u=String(input);calls.push(u);
   if(u.endsWith('/console_claim_campaign'))return Response.json([videoRow]);
   if(u.endsWith('/console_claimed_reel_object'))return Response.json(path);
   if(init.method==='HEAD')return new Response(null,{headers:{'content-length':String(size),'content-type':'video/mp4'}});
   if(u.includes('/object/sign/'))return Response.json({signedURL:'/object/sign/recruitment-reels/'+path+'?token=fixture'});
   return net.fetcher(input,init);
  };
  const r=await handleWorker(req(),{get},fetcher as typeof fetch);const out=await r.json();assert.equal(out.sent,size===1200?1:0);
  if(size===1200){assert.ok(calls.findIndex(u=>u.endsWith('/console_provider_boundary'))<calls.findIndex(u=>u.endsWith('/messages')));const p=net.payloads[net.calls.indexOf('messages')];assert.equal(p.template.components[0].parameters[0].type,'video');}
  else assert.equal(calls.some(u=>u.endsWith('/messages')),false);
 }
});
test('Hindi video uses Hindi message language, ordered job details, Hindi Apply button contract and STOP',()=>{
 const names=['requirement_code','company','job_role','job_location','qualification','salary','take_home','overtime','duty','benefits'];const v:any={template_contract:'registered_summary_v4',job_fingerprint:'a'.repeat(64)};for(const k of names)v[k]=k==='requirement_code'?'JOB-1':'जानकारी';
 const r={...row,template_name:'aadhyant_registered_job_video_hi_v1',template_language:'hi',template_variables:v};const p=templatePayload(r,'https://fixture.invalid/hindi.mp4');assert.equal(p.template.name,r.template_name);assert.equal(p.template.language.code,'hi');assert.equal(p.template.components[0].parameters[0].type,'video');assert.deepEqual(p.template.components[1].parameters.map(x=>x.text),names.map(k=>v[k]));assert.equal(p.template.components[2].parameters[0].text,'JOB-1');assert.equal(p.template.components[3].parameters[0].payload,'STOP');
 assert.throws(()=>templatePayload({...r,template_language:'en'},'https://fixture.invalid/hindi.mp4'));
});
