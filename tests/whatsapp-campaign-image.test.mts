import test from 'node:test';import assert from 'node:assert/strict';
import {handleCampaignImage} from '../supabase/functions/whatsapp-campaign-image/index.ts';
const owner='00000000-0000-4000-8000-000000000001';
const env:any={SUPABASE_URL:'https://synthetic.supabase.co',SUPABASE_ANON_KEY:'synthetic-anon',SUPABASE_SERVICE_ROLE_KEY:'synthetic-service'};
const get=(k:string)=>env[k]||'';
const png=new Uint8Array(120);png.set([137,80,78,71,13,10,26,10]);png.set(new TextEncoder().encode('IHDR'),12);new DataView(png.buffer).setUint32(16,32);new DataView(png.buffer).setUint32(20,32);
const jpg=new Uint8Array(120);jpg.set([255,216,255]);jpg.set([255,217],118);
const request=(body:Uint8Array=png,mime='image/png')=>new Request('https://edge.invalid',{method:'POST',headers:{origin:'https://aadhyantmanpower.in',authorization:'Bearer synthetic-admin','content-type':mime},body});
function fixture(options:any={}){const calls:any[]=[];let id:string,path:string;const fetcher=async(input:any,init:any)=>{const u=new URL(String(input));calls.push({u,init});assert.equal(u.origin,env.SUPABASE_URL);assert.equal(init.redirect,'error');if(u.pathname.endsWith('/admin_console_access'))return Response.json(!options.denied);if(u.pathname.endsWith('/auth/v1/user'))return Response.json({id:owner});if(u.pathname.includes('/object/sign/')){assert.deepEqual(JSON.parse(init.body),{expiresIn:300});return Response.json({signedURL:options.evil?'https://attacker.invalid/x':'/object/sign/whatsapp-campaign-media/'+path+'?token=synthetic'});}if(u.pathname.includes('/storage/v1/object/')){assert.equal(init.headers['x-upsert'],'false');path=u.pathname.split('/whatsapp-campaign-media/')[1];id=path.split('/')[0];return Response.json({Key:path});}if(u.pathname.endsWith('/console_register_campaign_image')){const args=JSON.parse(init.body);assert.equal(args.p_id,id);assert.equal(args.p_created_by,owner);assert.equal(args.p_size,120);return Response.json(options.registerFail?'wrong':id);}throw Error('Unexpected call');};return{calls,fetcher};}
for(const [mime,bytes,ext] of [['image/png',png,'.png'],['image/jpeg',jpg,'.jpg']] as const)test(mime+' uploads once to private media and returns only a signed preview',async()=>{const f=fixture(),r=await handleCampaignImage(request(bytes,mime),get,f.fetcher);assert.equal(r.status,200);const body=await r.json();assert.equal(body.byte_size,120);assert.ok(body.url.includes(ext+'?token='));assert.ok(!JSON.stringify(body).includes('synthetic-service'));assert.equal(f.calls.filter(c=>c.init.headers?.['x-upsert']==='false').length,1);});
test('admin denial precedes body parsing and all storage operations',async()=>{const f=fixture({denied:true});assert.equal((await handleCampaignImage(request(),get,f.fetcher)).status,403);assert.equal(f.calls.length,1);});
for(const [mime,data] of [['image/svg+xml',png],['image/jpeg',png],['image/png',jpg],['image/png',new Uint8Array(12)]] as const)test('reject mismatched or unsafe image '+mime+' '+data.length,async()=>{const f=fixture();assert.ok((await handleCampaignImage(request(data,mime),get,f.fetcher)).status>=400);assert.equal(f.calls.length,1);});
test('stream size limit is enforced without Content-Length',async()=>{const f=fixture();assert.equal((await handleCampaignImage(request(new Uint8Array(5000001)),get,f.fetcher)).status,413);assert.equal(f.calls.length,1);});
for(const option of [{registerFail:true},{evil:true}])test('partial storage completion cannot report a usable image '+JSON.stringify(option),async()=>{const f=fixture(option);const r=await handleCampaignImage(request(),get,f.fetcher);assert.equal(r.status,502);assert.ok(!JSON.stringify(await r.json()).includes('synthetic-service'));});
