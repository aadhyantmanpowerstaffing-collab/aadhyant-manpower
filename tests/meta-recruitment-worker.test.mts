import test from 'node:test';import assert from 'node:assert/strict';
import {handleWANotifierWorker as handle} from '../supabase/functions/wanotifier-outbox-worker/index.ts';
import {verifyRecruitmentTemplates} from '../supabase/functions/_shared/whatsapp/meta-recruitment-worker.ts';
import {recruitmentRoutes,recruitmentMetaPayload} from '../supabase/functions/_shared/whatsapp/recruitment-dispatch.ts';
const key='synthetic-worker-secret-at-least-32-characters';
const env:any={WHATSAPP_WORKER_SECRET:key,WHATSAPP_RECRUITMENT_UPDATES_ENABLED:'true',WHATSAPP_ACCESS_TOKEN:'synthetic-meta-token',WHATSAPP_PHONE_NUMBER_ID:'1415347881659158',WHATSAPP_BUSINESS_ACCOUNT_ID:'1386833723249335',SUPABASE_URL:'https://synthetic.supabase.co',SUPABASE_SERVICE_ROLE_KEY:'synthetic-service-key'};
const row={message_id:'synthetic-id',destination:'+919876543210',template_name:'aadhyant_interview_confirmation_hi_v1',template_language:'hi',template_variables:{requirement_code:'AAD-2026-000023',job_role:'Operator',event_date:'02 Jan 2099',event_time:'10:00 AM',venue:'Gate 1',instructions:'Review portal'}};
const templates=()=>Object.keys(recruitmentRoutes).map(name=>({id:name,name,language:name.includes('_hi_')?'hi':'en',status:'APPROVED',category:'UTILITY',components:[{type:'BODY',text:'{{1}} {{2}} {{3}} {{4}} {{5}} {{6}}'},...name.startsWith('aadhyant_joining_details_')?[]:[{type:'BUTTONS',buttons:[{type:'QUICK_REPLY',text:'Will attend'},{type:'QUICK_REPLY',text:'Cannot attend'}]}]]}));
const request=(body:any={kind:'recruitment_updates'},workerKey=key)=>new Request('https://synthetic.invalid',{method:'POST',headers:{'content-type':'application/json','x-whatsapp-worker-key':workerKey},body:JSON.stringify(body)});
function fixture(options:any={}){const calls:any[]=[],sends:any[]=[];
 const fetcher:typeof fetch=async(input,init)=>{const url=new URL(String(input)),name=url.pathname.split('/').pop()!;calls.push(name);
  if(url.origin==='https://graph.facebook.com'){
   assert.equal((init?.headers as any).authorization,'Bearer synthetic-meta-token');assert.equal(init?.redirect,'error');
   if(name==='phone_numbers')return Response.json({data:[{id:options.wrongPhone?'wrong':env.WHATSAPP_PHONE_NUMBER_ID}]});
   if(name==='subscribed_apps')return Response.json({data:options.missingApp?[]:[{whatsapp_business_api_data:{id:'2181424935760142'},...options.wrongCallback?{override_callback_uri:'https://wrong.invalid'}:{}}]});
   if(name==='message_templates')return Response.json({data:options.templates??templates(),...options.incomplete?{paging:{next:'untrusted',cursors:{}}}:{}});
   assert.equal(name,'messages');sends.push(JSON.parse(String(init?.body)));if(options.network)throw Error('synthetic-private-error');return Response.json(options.receipt??{messages:[{id:'wamid.synthetic'}]},{status:options.httpStatus??200});
  }
  assert.equal(url.origin,env.SUPABASE_URL);assert.doesNotMatch(JSON.stringify(init?.headers),/meta-token/);
  if(name==='console_sender_configuration')return Response.json({ready:true,phone_id:options.wrongConfig?'wrong':env.WHATSAPP_PHONE_NUMBER_ID,account_id:env.WHATSAPP_BUSINESS_ACCOUNT_ID});
  if(name==='console_claim_recruitment_notifications')return Response.json(options.rows??[row]);
  if(name==='console_recruitment_provider_boundary')return Response.json(options.boundary!==false);
  if(name==='console_refresh_recruitment_template_verification')return Response.json(options.refresh!==false);
  return Response.json(true);
 };return {calls,sends,fetcher};}
test('direct recruitment uses canonical guards and one Meta call without WANotifier credentials',async()=>{const f=fixture();const r=await handle(request(),k=>env[k]||'',f.fetcher);assert.equal(r.status,200);assert.deepEqual(await r.json(),{processed:1,sent:1,blocked:0,reconciliation_required:0});assert.deepEqual(f.sends,[recruitmentMetaPayload(row)]);assert.ok(f.calls.indexOf('subscribed_apps')<f.calls.indexOf('console_claim_recruitment_notifications'));assert.ok(f.calls.indexOf('console_refresh_recruitment_template_verification')<f.calls.indexOf('prepare_recruitment_notifications'));assert.ok(f.calls.indexOf('console_recruitment_provider_boundary')<f.calls.indexOf('messages'));});
test('all six templates have ordered variables and interview reply payloads only',()=>{for(const template_name of Object.keys(recruitmentRoutes)){const p=recruitmentMetaPayload({...row,template_name,template_language:template_name.includes('_hi_')?'hi':'en'});assert.equal(p.template.components.length,template_name.includes('joining_details')?1:3);assert.equal(p.template.components[0].parameters.length,6);}verifyRecruitmentTemplates(templates());});
for(const options of [{wrongPhone:true},{wrongConfig:true},{missingApp:true},{wrongCallback:true},{incomplete:true},{templates:[]},{refresh:false}])test('preflight failure cannot prepare, claim or send: '+JSON.stringify(options),async()=>{const f=fixture(options),r=await handle(request(),k=>env[k]||'',f.fetcher);assert.equal(r.status,503);assert.equal(f.sends.length,0);assert.ok(!f.calls.includes('prepare_recruitment_notifications'));});
for(const patch of [{status:'PENDING'},{category:'MARKETING'},{components:[{type:'BODY',text:'{{1}} {{2}} {{4}} {{3}} {{5}} {{6}}'}]},{components:[{type:'BODY',text:'{{1}} {{2}} {{3}} {{4}} {{5}} {{6}}'},{type:'HEADER',format:'IMAGE'}]}])test('changed template contract is rejected before claims',async()=>{const ts=templates();Object.assign(ts[0],patch);const f=fixture({templates:ts});assert.equal((await handle(request(),k=>env[k]||'',f.fetcher)).status,503);assert.equal(f.sends.length,0);assert.ok(!f.calls.includes('prepare_recruitment_notifications'));});
test('authentication, mixed-provider activation and caller overrides are rejected',async()=>{for(const [body,patch,workerKey] of [[{kind:'recruitment_updates'},{},'wrong'],[{kind:'recruitment_updates'},{WANOTIFIER_AUTOMATION_ENABLED:'true'},key],[{kind:'recruitment_updates',recipient:'+919876543210'},{},key],[{kind:'registered_alerts'},{},key]] as any[]){const f=fixture();assert.ok((await handle(request(body,workerKey),k=>({...env,...patch})[k]||'',f.fetcher)).status>=400);assert.equal(f.calls.length,0);}});
test('last consent/schedule boundary denial blocks Meta',async()=>{const f=fixture({boundary:false}),r=await handle(request(),k=>env[k]||'',f.fetcher);assert.equal((await r.json()).blocked,1);assert.equal(f.sends.length,0);});
for(const options of [{network:true},{httpStatus:400,receipt:{error:{code:131048},messages:[{id:'wamid.contradictory'}]}},{receipt:{error:false}},{receipt:{messages:[{id:'fake'}]}},{httpStatus:500},{receipt:{messages:[{id:'wamid.a'},{id:'wamid.b'}]}}])test('uncertain provider result never retries or reports sent',async()=>{const f=fixture(options),r=await handle(request(),k=>env[k]||'',f.fetcher);assert.equal((await r.json()).reconciliation_required,1);assert.equal(f.sends.length,1);assert.ok(!f.calls.includes('mark_whatsapp_outbound_sent'));assert.doesNotMatch(JSON.stringify(await Promise.resolve(f.calls)),/synthetic-private-error/);});

test('existing database wake key can authenticate only the bounded recruitment request',async()=>{for(const accepted of [true,false]){const f=fixture();const fetcher:typeof fetch=async(input,init)=>String(input).endsWith('/console_verify_automatic_wake')?Response.json(accepted):f.fetcher(input,init);const r=await handle(new Request('https://synthetic.invalid',{method:'POST',headers:{'content-type':'application/json','x-whatsapp-wake-key':'a'.repeat(64)},body:JSON.stringify({kind:'recruitment_updates'})}),k=>env[k]||'',fetcher);assert.equal(r.status,accepted?200:401);assert.equal(f.sends.length,accepted?1:0);}});
