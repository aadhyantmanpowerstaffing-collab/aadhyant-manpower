import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';
import {handleTemplateSetup,reviewedTemplate} from '../supabase/functions/whatsapp-registered-template-setup/index.ts';
const env:any={SUPABASE_URL:'https://fixture.invalid',SUPABASE_ANON_KEY:'anon',SUPABASE_SERVICE_ROLE_KEY:'service',WHATSAPP_BUSINESS_ACCOUNT_ID:'1234567890',WHATSAPP_ACCESS_TOKEN:'fixture'};
const req=(body='{}')=>new Request('https://fixture.invalid',{method:'POST',headers:{origin:'https://aadhyantmanpower.in',authorization:'Bearer user'},body});
const get=(k:string)=>env[k]||'';
function net(options:any={}){const calls:any[]=[];return {calls,fetcher:(async(url:any,init:any)=>{calls.push({url:String(url),method:init?.method||'GET',body:init?.body});if(String(url).includes('admin_console_access'))return Response.json(options.admin!==false);if(String(url).includes('console_sender_configuration'))return Response.json({account_id:options.account||env.WHATSAPP_BUSINESS_ACCOUNT_ID});if(init?.method==='POST'){if(options.ambiguous)throw Error('timeout');return Response.json({id:'1234567899',status:'PENDING'});}return Response.json({data:options.existing||[]});}) as typeof fetch};}
test('only the exact reviewed static request is submitted; account and Admin checks precede Meta',async()=>{assert.deepEqual(reviewedTemplate,JSON.parse(fs.readFileSync('docs/whatsapp/registered-job-alert-template-v3.json','utf8')));const n=net();const r=await handleTemplateSetup(req(),get,n.fetcher);assert.equal(r.status,200);assert.equal((await r.json()).status,'PENDING');assert.deepEqual(JSON.parse(n.calls.at(-1).body),reviewedTemplate);assert.equal(n.calls.filter(x=>x.url.includes('message_templates')&&x.method==='POST').length,1);assert.equal(n.calls.some(x=>x.url.endsWith('/messages')),false);});
test('existing exact template is reused without a duplicate create; different content is not overwritten',async()=>{const existing={...reviewedTemplate,id:'1234567899',status:'APPROVED'};let n=net({existing:[existing]});assert.equal((await(await handleTemplateSetup(req(),get,n.fetcher)).json()).created,false);assert.equal(n.calls.filter(x=>x.url.includes('message_templates')&&x.method==='POST').length,0);n=net({existing:[{...existing,components:[]}]});assert.equal((await handleTemplateSetup(req(),get,n.fetcher)).status,409);});
test('wrong account, non-Admin, payload override and ambiguous create never cause an automatic retry',async()=>{for(const options of [{admin:false},{account:'9999999999'}]){const n=net(options);assert.ok((await handleTemplateSetup(req(),get,n.fetcher)).status>=400);assert.equal(n.calls.some(x=>x.url.includes('graph.facebook')),false);}const bad=net();assert.equal((await handleTemplateSetup(req('{"to":"anything"}'),get,bad.fetcher)).status,400);assert.equal(bad.calls.length,0);const n=net({ambiguous:true});assert.equal((await handleTemplateSetup(req(),get,n.fetcher)).status,502);assert.equal(n.calls.filter(x=>x.url.includes('message_templates')&&x.method==='POST').length,1);});
