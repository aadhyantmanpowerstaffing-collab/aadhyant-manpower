import test from 'node:test';import assert from 'node:assert/strict';
import {isEmployerPostJob,employerPostJobPayload,sendEmployerPostJob} from '../supabase/functions/_shared/whatsapp/employer-post-job.ts';
import {createSupabaseWebhookPersistence,handleWhatsAppWebhook} from '../supabase/functions/whatsapp-webhook/index.ts';
import {calculateMetaSignature} from '../supabase/functions/_shared/whatsapp/signature.ts';
const id='00000000-0000-0000-0000-000000000001';
const row={message_id:id,destination:'+919876543210',purpose:'employer_post_job',consent_class:'transactional',message_type:'session_text',template_variables:{entry_point:'post_job_v1'}};
test('only explicit employer commands route; reply has one fixed secure form link without authority or opt-in',()=>{for(const t of ['POST JOB',' post   job ','PostJob','POST_JOB','NEW VACANCY','Post Vacancy'])assert.equal(isEmployerPostJob(t),true);for(const t of ['job','Interested','STOP','Post a job please','my POST JOB account',null])assert.equal(isEmployerPostJob(t),false);const p=employerPostJobPayload(row);assert.match(p.text.body,/https:\/\/aadhyantmanpower.in\/post-job\//);assert.match(p.text.body,/Sign in with your own approved/);assert.match(p.text.body,/does not subscribe/);for(const change of [{consent_class:'marketing'},{destination:'+12025550100'},{template_variables:{entry_point:'evil'}},{template_variables:{entry_point:'post_job_v1',url:'https://evil.invalid'}}])assert.throws(()=>employerPostJobPayload({...row,...change}));});
for(const failure of ['none','boundary','timeout'])test('employer reply uses canonical single-attempt boundary and reconciliation: '+failure,async()=>{const calls:string[]=[],args:any[]=[];const rpc=async(name:string,body:any)=>{calls.push(name);args.push(body);if(name==='console_claim_employer_post_job')return [row];if(name==='console_employer_post_job_boundary'&&failure==='boundary')throw Error('suppressed');return true;};const fetcher:typeof fetch=async()=>{calls.push('provider');if(failure==='timeout')throw Error('timeout');return Response.json({messages:[{id:'wamid.synthetic'}]});};await sendEmployerPostJob(id,rpc,{ready:true,phone_id:'1234567891',account_id:'1234567890'},'synthetic',fetcher);assert.equal(calls[0],'console_claim_employer_post_job');assert.equal(calls[1],'console_employer_post_job_boundary');assert.equal(calls.filter(x=>x==='provider').length,failure==='boundary'?0:1);if(failure==='timeout')assert.equal(args.at(-1).p_failure_kind,'ambiguous');});
test('signed employer ingress persists command classification and routes before candidate intake; replay sends once',async()=>{const calls:string[]=[],bodies:any[]=[];const env={appSecret:'synthetic-secret',verifyToken:'synthetic',supabaseUrl:'https://fixture.invalid',supabaseSecretKey:'synthetic-service',accessToken:'synthetic-token',businessAccountId:'1234567890',phoneNumberId:'1234567891'};const fetcher:typeof fetch=async(input,init)=>{const name=String(input).split('/').at(-1)!;calls.push(name);bodies.push(JSON.parse(String(init?.body||'{}')));const values:any={accept_whatsapp_webhook_event:id,upsert_whatsapp_inbound_contact:id,record_whatsapp_inbound_message:id,console_process_employer_post_job:{handled:true,outbound_id:id},console_sender_configuration:{ready:true,phone_id:'1234567891',account_id:'1234567890'},console_claim_employer_post_job:[],console_employer_post_job_boundary:true,mark_whatsapp_outbound_sent:true,messages:{messages:[{id:'wamid.synthetic'}]}};if(name==='console_claim_employer_post_job')return Response.json(calls.filter(x=>x===name).length===1?[row]:[]);assert.ok(name in values,'Unexpected RPC '+name);return Response.json(values[name]);};
 const body=JSON.stringify({object:'whatsapp_business_account',entry:[{id:env.businessAccountId,changes:[{value:{metadata:{phone_number_id:env.phoneNumberId},messages:[{id:'wamid.command',from:'919876543210',timestamp:String(Math.floor(Date.now()/1000)),type:'text',text:{body:'Post Job'}}]}}]}]});const signature=await calculateMetaSignature(new TextEncoder().encode(body),env.appSecret);const request=()=>new Request('https://fixture.invalid',{method:'POST',headers:{'content-type':'application/json','x-hub-signature-256':signature},body});const f=createSupabaseWebhookPersistence(env,fetcher);for(let i=0;i<2;i++)assert.equal((await handleWhatsAppWebhook(request(),env,f.acceptEvent,f.processEvent)).status,200);const persisted=bodies[calls.indexOf('record_whatsapp_inbound_message')];assert.equal(persisted.p_action_id,'POST_JOB');assert.equal(persisted.p_safe_text,'Post Job');assert.ok(calls.indexOf('record_whatsapp_inbound_message')<calls.indexOf('console_process_employer_post_job'));assert.equal(calls.includes('console_process_registration_chat'),false);assert.equal(calls.includes('set_whatsapp_contact_suppression'),false);assert.equal(calls.filter(x=>x==='messages').length,1);
 const before=calls.length;assert.equal((await handleWhatsAppWebhook(new Request('https://fixture.invalid',{method:'POST',headers:{'content-type':'application/json'},body}),env,f.acceptEvent,f.processEvent)).status,403);assert.equal(calls.length,before);
});
