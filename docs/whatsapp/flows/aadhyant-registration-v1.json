{
  "version": "7.2",
  "screens": [
    {
      "id": "PERSONAL",
      "title": "Aadhyant Registration",
      "data": {
        "requirement_code": {
          "type": "string",
          "__example__": "AAD-2026-000003"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "${data.requirement_code}"
          },
          {
            "type": "Form",
            "name": "personal",
            "children": [
              {
                "type": "TextInput",
                "name": "full_name",
                "label": "Full name",
                "required": true,
                "max-chars": 160
              },
              {
                "type": "TextInput",
                "name": "age",
                "label": "Age (16 to 75)",
                "required": true,
                "input-type": "number",
                "max-chars": 2
              },
              {
                "type": "Dropdown",
                "name": "gender",
                "label": "Gender",
                "required": true,
                "data-source": [
                  {
                    "id": "Male",
                    "title": "Male"
                  },
                  {
                    "id": "Female",
                    "title": "Female"
                  },
                  {
                    "id": "Other / Prefer not to say",
                    "title": "Other / Prefer not to say"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "state",
                "label": "State",
                "required": true,
                "data-source": [
                  {
                    "id": "Andaman and Nicobar Islands",
                    "title": "Andaman and Nicobar Islands"
                  },
                  {
                    "id": "Andhra Pradesh",
                    "title": "Andhra Pradesh"
                  },
                  {
                    "id": "Arunachal Pradesh",
                    "title": "Arunachal Pradesh"
                  },
                  {
                    "id": "Assam",
                    "title": "Assam"
                  },
                  {
                    "id": "Bihar",
                    "title": "Bihar"
                  },
                  {
                    "id": "Chandigarh",
                    "title": "Chandigarh"
                  },
                  {
                    "id": "Chhattisgarh",
                    "title": "Chhattisgarh"
                  },
                  {
                    "id": "Dadra and Nagar Haveli and Daman and Diu",
                    "title": "Dadra and Nagar Haveli and Dam"
                  },
                  {
                    "id": "Delhi",
                    "title": "Delhi"
                  },
                  {
                    "id": "Goa",
                    "title": "Goa"
                  },
                  {
                    "id": "Gujarat",
                    "title": "Gujarat"
                  },
                  {
                    "id": "Haryana",
                    "title": "Haryana"
                  },
                  {
                    "id": "Himachal Pradesh",
                    "title": "Himachal Pradesh"
                  },
                  {
                    "id": "Jammu and Kashmir",
                    "title": "Jammu and Kashmir"
                  },
                  {
                    "id": "Jharkhand",
                    "title": "Jharkhand"
                  },
                  {
                    "id": "Karnataka",
                    "title": "Karnataka"
                  },
                  {
                    "id": "Kerala",
                    "title": "Kerala"
                  },
                  {
                    "id": "Ladakh",
                    "title": "Ladakh"
                  },
                  {
                    "id": "Lakshadweep",
                    "title": "Lakshadweep"
                  },
                  {
                    "id": "Madhya Pradesh",
                    "title": "Madhya Pradesh"
                  },
                  {
                    "id": "Maharashtra",
                    "title": "Maharashtra"
                  },
                  {
                    "id": "Manipur",
                    "title": "Manipur"
                  },
                  {
                    "id": "Meghalaya",
                    "title": "Meghalaya"
                  },
                  {
                    "id": "Mizoram",
                    "title": "Mizoram"
                  },
                  {
                    "id": "Nagaland",
                    "title": "Nagaland"
                  },
                  {
                    "id": "Odisha",
                    "title": "Odisha"
                  },
                  {
                    "id": "Puducherry",
                    "title": "Puducherry"
                  },
                  {
                    "id": "Punjab",
                    "title": "Punjab"
                  },
                  {
                    "id": "Rajasthan",
                    "title": "Rajasthan"
                  },
                  {
                    "id": "Sikkim",
                    "title": "Sikkim"
                  },
                  {
                    "id": "Tamil Nadu",
                    "title": "Tamil Nadu"
                  },
                  {
                    "id": "Telangana",
                    "title": "Telangana"
                  },
                  {
                    "id": "Tripura",
                    "title": "Tripura"
                  },
                  {
                    "id": "Uttar Pradesh",
                    "title": "Uttar Pradesh"
                  },
                  {
                    "id": "Uttarakhand",
                    "title": "Uttarakhand"
                  },
                  {
                    "id": "West Bengal",
                    "title": "West Bengal"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "district",
                "label": "District",
                "required": true,
                "max-chars": 160
              },
              {
                "type": "TextInput",
                "name": "current_village_city",
                "label": "Village / City",
                "required": true,
                "max-chars": 200
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "EDUCATION"
                  },
                  "payload": {
                    "full_name": "${form.full_name}",
                    "age": "${form.age}",
                    "gender": "${form.gender}",
                    "state": "${form.state}",
                    "district": "${form.district}",
                    "current_village_city": "${form.current_village_city}",
                    "requirement_code": "${data.requirement_code}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "EDUCATION",
      "title": "Job and Consent",
      "terminal": true,
      "success": true,
      "data": {
        "full_name": {
          "type": "string",
          "__example__": "Example"
        },
        "age": {
          "type": "number",
          "__example__": 25
        },
        "gender": {
          "type": "string",
          "__example__": "Example"
        },
        "state": {
          "type": "string",
          "__example__": "Example"
        },
        "district": {
          "type": "string",
          "__example__": "Example"
        },
        "current_village_city": {
          "type": "string",
          "__example__": "Example"
        },
        "requirement_code": {
          "type": "string",
          "__example__": "AAD-2026-000003"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "${data.requirement_code}"
          },
          {
            "type": "Form",
            "name": "education",
            "children": [
              {
                "type": "Dropdown",
                "name": "highest_qualification",
                "label": "Qualification",
                "required": true,
                "data-source": [
                  {
                    "id": "Below 10th",
                    "title": "Below 10th"
                  },
                  {
                    "id": "10th",
                    "title": "10th"
                  },
                  {
                    "id": "12th",
                    "title": "12th"
                  },
                  {
                    "id": "ITI",
                    "title": "ITI"
                  },
                  {
                    "id": "Diploma",
                    "title": "Diploma"
                  },
                  {
                    "id": "Graduate",
                    "title": "Graduate"
                  },
                  {
                    "id": "Post Graduate",
                    "title": "Post Graduate"
                  },
                  {
                    "id": "Other",
                    "title": "Other"
                  }
                ]
              },
              {
                "type": "TextInput",
                "name": "course_trade_specialization",
                "label": "Trade / Course",
                "required": true,
                "max-chars": 160,
                "helper-text": "Enter NA if not applicable."
              },
              {
                "type": "Dropdown",
                "name": "experience_status",
                "label": "Experience",
                "required": true,
                "data-source": [
                  {
                    "id": "Fresher",
                    "title": "Fresher"
                  },
                  {
                    "id": "Experienced",
                    "title": "Experienced"
                  }
                ]
              },
              {
                "type": "Dropdown",
                "name": "interview_available",
                "label": "Interview available?",
                "required": true,
                "data-source": [
                  {
                    "id": "Yes",
                    "title": "Yes"
                  },
                  {
                    "id": "No",
                    "title": "No"
                  }
                ]
              },
              {
                "type": "TextBody",
                "text": "Submit records your basic Candidate registration and interest in this job. Do not enter Aadhaar, bank details or passwords here."
              },
              {
                "type": "OptIn",
                "name": "registration_consent",
                "label": "I agree to registration and contact about this job.",
                "required": true
              },
              {
                "type": "TextBody",
                "text": "Job alerts are optional. Select the checkbox to receive all Aadhyant job alerts on this WhatsApp number, including jobs that may not match your profile. Reply STOP to turn alerts off."
              },
              {
                "type": "OptIn",
                "name": "job_alert_consent",
                "label": "I want all Aadhyant job alerts on WhatsApp.",
                "required": false
              },
              {
                "type": "Footer",
                "label": "Submit",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "full_name": "${data.full_name}",
                    "age": "${data.age}",
                    "gender": "${data.gender}",
                    "state": "${data.state}",
                    "district": "${data.district}",
                    "current_village_city": "${data.current_village_city}",
                    "highest_qualification": "${form.highest_qualification}",
                    "course_trade_specialization": "${form.course_trade_specialization}",
                    "experience_status": "${form.experience_status}",
                    "interview_available": "${form.interview_available}",
                    "registration_consent": "${form.registration_consent}",
                    "job_alert_consent": "${form.job_alert_consent}",
                    "form_kind": "aadhyant_registration_v1",
                    "consent_policy_version": "wa-registration-alerts-v1"
                  }
                }
              }
            ],
            "init-values": {
              "registration_consent": false,
              "job_alert_consent": false
            }
          }
        ]
      }
    }
  ],
  "routing_model": {
    "PERSONAL": [
      "EDUCATION"
    ],
    "EDUCATION": []
  }
}
